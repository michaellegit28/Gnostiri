# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/gnostiri"

# Supabase Auth (Google OAuth + email/password)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Auth redirect (optional): pinned production origin; preview/localhost
# deployments fall back to their own origin automatically.
NEXT_PUBLIC_AUTH_REDIRECT_BASE_URL=""
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="true"

# OpenAI (AI tutor)
OPENAI_API_KEY=""

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Paystack
PAYSTACK_SECRET_KEY=""
# Optional: dashboard webhook signing secret (whsec_…) for the newer
# Paystack-Signature scheme; the secret-key x-paystack-signature header is
# honoured when this is unset. Never commit values here — names only.
PAYSTACK_WEBHOOK_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Tutor model (defaults to gpt-4o-mini)
OPENAI_TUTOR_MODEL="gpt-4o-mini"

# Admin allowlist (comma-separated emails, reuses Firebase session auth)
ADMIN_EMAILS=""

# On-demand ISR revalidation for admin edits
REVALIDATE_SECRET=""
