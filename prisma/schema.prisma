generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppDomain {
  highschool
  university
  extras
}

model User {
  id             String         @id @default(cuid())
  firebaseUid    String         @unique
  email          String         @unique
  name           String?
  avatar         String?
  country        String?
  createdAt      DateTime       @default(now())

  profile        Profile?
  subscriptions  Subscription[]
  quizAttempts   QuizAttempt[]
  progress       Progress[]
  tutorSessions  TutorSession[]
  studyPlans     StudyPlan[]
  paperAttempts  PaperAttempt[]
}

model Profile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentDomain AppDomain @default(highschool)
  streak        Int       @default(0)
  lastActive    DateTime  @default(now())
  preferredExam String?
}

model Subscription {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         String      @default("free") // 'free' | 'premium'
  domainAccess AppDomain[]
  expiresAt    DateTime?
  provider     String?
  status       String      @default("active")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  providerRef  String?     @unique
  billingPeriod String     @default("monthly")
}

model Domain {
  id                   String  @id @default(cuid())
  slug                 String  @unique
  name                 String
  isPublic             Boolean @default(true)
  requiresSubscription Boolean @default(false)
}

model Examination {
  id          String      @id @default(cuid())
  domain      AppDomain
  name        String
  code        String
  slug        String      @unique
  country     String?
  syllabusUrl String?
  papers      ExamPaper[]
}

enum AlignmentTier {
  core
  elective
  excluded
}

model Region {
  id          String            @id @default(cuid())
  name        String
  isoCode     String            @unique
  rtlLanguage Boolean           @default(false)
  boards      CurriculumBoard[]
}

model CurriculumBoard {
  id                 String                @id @default(cuid())
  name               String
  regionId           String
  region             Region                @relation(fields: [regionId], references: [id], onDelete: Cascade)
  officialSyllabusUrl String?
  syllabusVersionYear Int?
  lastAuditedDate    DateTime
  tracks             StudyTrack[]
  alignments         TopicBoardAlignment[]

  @@index([regionId])
}

model Department {
  id       String  @id @default(cuid())
  name     String  @unique
  iconSlug String?
  topics   Topic[]
}

model StudyTrack {
  id          String                @id @default(cuid())
  boardId     String
  board       CurriculumBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  description String?
  alignments  TopicBoardAlignment[]

  @@index([boardId])
}

model TopicBoardAlignment {
  id                    String          @id @default(cuid())
  topicId               String
  topic                 Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  boardId               String
  board                 CurriculumBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  trackId               String?
  track                 StudyTrack?     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tier                  AlignmentTier
  languageOfInstruction String?
  weightNotes           String?
  verifiedDate          DateTime
  verifiedBy            String?

  @@unique([topicId, boardId, trackId])
  @@index([topicId, boardId])
  @@index([tier])
  @@index([boardId])
}

model AlignmentAudit {
  id            String   @id @default(cuid())
  alignmentId   String
  actorEmail    String?
  action        String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([alignmentId])
}

model Topic {
  id            String         @id @default(cuid())
  domain        AppDomain
  parentId      String?
  parent        Topic?         @relation("TopicHierarchy", fields: [parentId], references: [id])
  children      Topic[]        @relation("TopicHierarchy")
  title         String
  description   String?
  orderIndex    Int            @default(0)
  isPublished   Boolean        @default(true)
  lessons       Lesson[]
  questions     Question[]
  quizAttempts  QuizAttempt[]
  tutorSessions TutorSession[]
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  slug          String?        @unique
  lastAuditedDate DateTime?
  needsVerification Boolean    @default(true)
  alignments    TopicBoardAlignment[]
}

model Lesson {
  id               String    @id @default(cuid())
  domain           AppDomain
  topicId          String
  topic            Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title            String
  content          Json
  orderIndex       Int       @default(0)
  estimatedMinutes Int       @default(10)
}

model Question {
  id           String    @id @default(cuid())
  domain       AppDomain
  topicId      String
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type         String    @default("mcq")
  questionText String
  options      Json
  correctAnswer String
  explanation  String?
  difficulty   String    @default("medium")
  sourceExam   String?
}

model QuizAttempt {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain          AppDomain
  topicId         String
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  score           Int
  maxScore        Int
  answers         Json
  durationSeconds Int
  createdAt       DateTime  @default(now())
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      AppDomain
  entityType  String
  entityId    String
  status      String    @default("not_started") // 'not_started' | 'in_progress' | 'completed' | 'mastered'
  accuracy    Float?
  lastStudied DateTime  @default(now())
}

model TutorSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    AppDomain
  subjectId String?
  topicId   String?
  topic     Topic?    @relation(fields: [topicId], references: [id])
  messages  Json
  context   String?
  createdAt DateTime  @default(now())
}

model StudyPlan {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      AppDomain
  examDate    DateTime?
  items       Json
  isActive    Boolean   @default(true)
  generatedBy String    @default("ai") // 'manual' | 'ai'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  domain      AppDomain
  slug        String
  title       String
  department  String
  description String?
  isPublished Boolean  @default(true)
  lessons     CourseLesson[]
  certificates Certificate[]
  questions   CourseQuestion[]
  quizAttempts CourseQuizAttempt[]
  @@unique([domain, slug])
}

model CourseQuestion {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  domain        AppDomain @default(university)
  questionText  String
  options       Json
  correctAnswer String
  explanation   String?
}

model CourseQuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  domain    AppDomain @default(university)
  score     Int
  maxScore  Int
  createdAt DateTime @default(now())
}

model CourseLesson {
  id               String   @id @default(cuid())
  courseId         String
  domain           AppDomain @default(university)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  content          Json
  orderIndex       Int      @default(0)
  estimatedMinutes Int      @default(10)
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  domain      AppDomain @default(university)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt    DateTime @default(now())
  @@unique([userId, courseId])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  provider  String
  createdAt DateTime @default(now())
}
